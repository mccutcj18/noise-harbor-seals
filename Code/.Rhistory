sample_sizes <- surfacetime %>%
group_by(month_year) %>%
summarize(sample_size = n(),
mean_surfacetime = mean(avgsurfacetime, na.rm = TRUE), # CALCULATE MEAN
sd_surfacetime = sd(avgsurfacetime, na.rm = TRUE)      # CALCULATE SD
)

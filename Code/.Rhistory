## READ IN DATA
bham_current=nc_open("../Data/bellingham_bay_2023.06.01_2024.02.26.nc")
bham_current2=nc_open("../Data/bellingham_bay_2024.02.26_2024.06.08.nc")
## OPEN THE NET CDF FILE
ncin <- nc_open(bham_current)
## OPEN THE NET CDF FILE
